# Rename to .env on the server; replace __FILL_*__ placeholders.

SERVER_PORT=8080
BASE_URL=http://__FILL_PUBLIC_URL__
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=10s

LOG_LEVEL=info

DB_HOST=__FILL_RDS_HOST__
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=__FILL_RDS_PASSWORD__
DB_NAME=releases
DB_SSLMODE=require
DB_QUERY_TIMEOUT=5s
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

REDIS_ADDR=__FILL_REDIS_HOST:6379__
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_MAX_RETRIES=3

SMTP_HOST=email-smtp.__FILL_AWS_REGION__.amazonaws.com
SMTP_PORT=587
SMTP_USER=__FILL_SES_SMTP_USERNAME__
SMTP_PASSWORD=__FILL_SES_SMTP_PASSWORD__
SMTP_FROM=__FILL_VERIFIED_FROM__
SMTP_TIMEOUT=10s

GITHUB_TOKEN=__FILL_GITHUB_PAT__
GITHUB_BASE_URL=https://api.github.com
GITHUB_TIMEOUT=15s
GITHUB_MAX_RETRIES=3
GITHUB_CACHE_TTL=10m

SCANNER_INTERVAL=5m
SCANNER_CYCLE_TIMEOUT=4m
SCANNER_REPO_TIMEOUT=30s

GRPC_PORT=50051

API_KEY=
