# Server
SERVER_PORT=8080
BASE_URL=http://localhost:8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=10s

# Logging (debug, info, warn, error)
LOG_LEVEL=info

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=releases
DB_SSLMODE=disable
DB_QUERY_TIMEOUT=5s
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_MAX_RETRIES=3

# SMTP
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TIMEOUT=10s

# GitHub
GITHUB_TOKEN=
GITHUB_BASE_URL=https://api.github.com
GITHUB_TIMEOUT=15s
GITHUB_MAX_RETRIES=3
GITHUB_CACHE_TTL=10m

# Scanner
SCANNER_INTERVAL=5m
SCANNER_CYCLE_TIMEOUT=4m
SCANNER_REPO_TIMEOUT=30s

# gRPC
GRPC_PORT=50051

# API Key authentication (optional extra feature)
# Leave empty (default for local demo / browser HTML page): REST /api/* works without X-API-Key.
# Set a non-empty value to enable: clients must send header X-API-Key with the same value.
# The bundled web UI does not send this header; use API_KEY only when calling the API from scripts or tools.
API_KEY=
